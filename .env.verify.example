# Secrets for scripts/verify-metering.sh AND deploy/deploy.sh. Copy to
# .env.verify (gitignored) and fill in. Both scripts source this file.
#
#   cp .env.verify.example .env.verify
#   # then edit .env.verify with your real values
#
# ── verify-metering.sh (local agar-oss run) ─────────────────────────────
# OpenRouter is required: metering only activates when set (METERED =
# bool(OPENROUTER_API_KEY) in agar-oss/api/main.py). Without it the sim runs
# unmetered and balance never moves — there is nothing to verify. A single
# 36-agent round costs roughly $0.04 (Gemini 2.5 Flash).
OPENROUTER_API_KEY=

# Shared secret that gates /tokens and /credits/add on agar-api. Local verify
# uses any non-empty value; on hosted this is the production secret pushed to
# both Fly (agar-api) and Cloudflare Workers (disc-app-api) so they share it.
# Generate with: openssl rand -hex 32
AGAR_MINT_SECRET=

# ── deploy/deploy.sh (Fly + Cloudflare) ─────────────────────────────────
# Email sender API key. Sign up at resend.com, create an API key. Free tier
# covers ~3000/mo. Use a verified sending domain in prod; onboarding@resend.dev
# works for testing but lands in spam more often.
RESEND_API_KEY=

# Production frontend origin. Used three places: CORS on agar-api, CORS on
# disc-app-api Worker, magic-link URLs in emails. No trailing slash.
APP_ORIGIN=

# Cloudflare Pages project name. Matches `wrangler pages deploy --project-name`.
CF_PAGES_PROJECT=

# Fly app name for agar-api. Default 'agar-api' from the prior deploy.
FLY_APP=agar-api

# HMAC key for signed session cookies on disc-app-api. Generated automatically
# by deploy.sh on first worker deploy if blank — keep whatever it writes here
# (rotating it logs every user out). Generate manually with:
#   openssl rand -hex 32
SESSION_SIGNING_KEY=
